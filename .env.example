# Not needed for `npm run local` (it sets everything itself). For your own server (Vercel + Neon) and
# the worker on your computer (`npm run worker` reads .env.local):

# Postgres (Neon)
DATABASE_URL=
# Password for the site (empty = no login)
APP_PASSWORD=
# Shared secret between the site and the worker (any random string, the same on both)
CRON_SECRET=
# Address of the site, for the worker
APP_URL=https://your-app.vercel.app

# Optional paid / extra sources (all off by default)
ANTHROPIC_API_KEY=          # only used when the rule parser cannot resolve a place (Haiku)
SERPAPI_KEY=                # optional fallback; SERP_EXPLORE_DAILY_BUDGET=0 by default
SERP_EXPLORE_DAILY_BUDGET=0
DUFFEL_TOKEN=               # ignored unless DUFFEL_LIVE=1 (test tokens return fictional airlines)
DUFFEL_LIVE=0
# Optional: e-mail when a long search ends (free Resend account)
RESEND_API_KEY=
ALERT_EMAIL=

# Limits per search
MAX_FREE_CALLS_PER_SEARCH=320
MAX_GOOGLE_CALLS_PER_SEARCH=40
MAX_KIWI_CALLS_PER_SEARCH=70
MAX_SEARCH_SECONDS=235
FLEX_DAYS=3
WORKER_FAST_MINUTES=12
