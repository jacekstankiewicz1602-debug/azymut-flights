{
  "name": "azymut",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx scripts/test-engine.ts",
    "worker": "set -a; [ -f .env.local ] && . ./.env.local; [ -f .env ] && . ./.env; [ -f .env.worker ] && . ./.env.worker; set +a; node --max-old-space-size=3000 --import tsx scripts/worker.ts",
    "local": "node --import tsx scripts/local.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "maplibre-gl": "5.24.0",
    "next": "^15.5.29",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
